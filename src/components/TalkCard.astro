---
import type { CollectionEntry } from 'astro:content';
import ArrowLink from './ArrowLink.astro';
interface Props { talk: CollectionEntry<'talks'>; index: number; compact?: boolean; }
const { talk, index, compact = false } = Astro.props;
const year = Math.max(...talk.data.appearances.map((item) => item.year ?? 0));
---
<article class:list={["talk-card", { "talk-card-no-links": !talk.data.showLinks, "talk-card-compact": compact }]}>
  <div class="talk-index"><strong>{year || '—'}</strong>{!compact && <span>{String(index + 1).padStart(2, '0')}</span>}</div>
  <div class="talk-main">
    <div class="talk-meta">{talk.data.atlassian && <img class="talk-brand" src="/img/logos/atlassian.svg" alt="Atlassian" width="156" height="20" loading="lazy" />}<p class="card-meta">{talk.data.topic}</p></div>
    <h4>{talk.data.title}</h4>
    <p>{talk.data.summary}</p>
    <p class="appearances">{talk.data.appearances.map((item: any) => `${item.event}${item.year ? ` · ${item.year}` : ''}`).join(' / ')}</p>
  </div>
  {talk.data.showLinks && <div class="talk-action">
    {talk.data.recording && <ArrowLink href={talk.data.recording} label={talk.data.recordingLabel ?? 'Watch recording'} external />}
    <a class="detail-link" href={`/speaking/${talk.id}/`}>Talk details</a>
  </div>}
</article>
