---
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Matt Colman — Engineering leader. Hands-on builder.',
  description = 'Matt Colman is a Sydney-based engineering leader, hands-on product builder, and conference speaker.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="topbar">
        <a class="identity" href="/" aria-label="Matt Colman, home">
          <img src="/img/profile.png" alt="" width="32" height="32" />
          <span>Matt Colman</span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="/#work">Work</a>
          <a href="/#speaking">Speaking</a>
          <a href="mailto:matt@mattcolman.com">Say hello <span aria-hidden="true">↗</span></a>
        </nav>
        <details class="mobile-menu">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation">
            <a href="/#work">Work</a>
            <a href="/#speaking">Speaking</a>
            <a href="mailto:matt@mattcolman.com">Say hello ↗</a>
          </nav>
        </details>
      </header>
      <main id="main"><slot /></main>
      <Footer />
    </div>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      const summary = menu?.querySelector('summary');

      if (menu) {
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => { menu.open = false; });
        });
        document.addEventListener('click', (event) => {
          if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu.open) {
            menu.open = false;
            summary?.focus();
          }
        });
        window.matchMedia('(min-width: 921px)').addEventListener('change', () => { menu.open = false; });
      }
    </script>
  </body>
</html>
