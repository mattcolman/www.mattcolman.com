---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = await getCollection('projects');
const projectById = new Map(projects.map((project) => [project.id, project]));
const featuredProjects = [
  {
    id: 'jira-coding-agent',
    company: 'Atlassian',
    area: 'AI & developer tools',
    role: 'Senior Engineering manager',
    displayTitle: 'Jira Coding Agent',
    build: '15 engineers. Zero to general availability.',
    lead: 'Led 15 engineers from zero to general availability.',
    speak: 'Product launches, live demos and workshops for developers.',
  },
  {
    id: 'domain-search',
    company: 'Domain',
    area: 'Consumer web',
    role: 'Team lead',
    displayTitle: 'Search at scale',
    build: 'Search and listings across desktop and mobile web.',
    lead: 'Led the team behind the highest-traffic part of the business.',
    speak: 'Experience leading teams behind high-traffic consumer products.',
  },
  {
    id: 'reading-eggs',
    company: 'Reading Eggs',
    area: 'Games & education',
    role: 'Team lead',
    displayTitle: 'A new life for 120 lessons',
    build: 'Rebuilt Reading Eggs and its games arcade from Flash to HTML5.',
    lead: 'Led five engineers and five designers through the HTML5 rebuild.',
    speak: 'Years of making games shaped how I think about interaction and motion.',
    extra: { href: 'https://vimeo.com/196944609', label: 'See my old games showreel' },
  },
].map((item) => ({ ...item, project: projectById.get(item.id) }));

const talkById = new Map((await getCollection('talks')).map((talk) => [talk.id, talk]));
const featuredTalks = ['building-an-ai-team', 'whose-job-is-animation', 'flip-floppers']
  .map((id) => talkById.get(id))
  .filter((talk) => talk !== undefined);
---
<BaseLayout>
  <section class="hero" aria-labelledby="intro-title">
    <div class="intro-grid">
      <div>
        <p class="location"><span aria-hidden="true"></span>Sydney, Australia</p>
        <h1 id="intro-title"><span>Engineering leader.</span><span>Hands-on builder.</span></h1>
        <p class="intro-copy">I’m Matt. I’ve built games, led teams at Atlassian and helped bring AI developer tools to life. I care about the product, the people and the details.</p>
        <p class="now-line"><span class="label">Now</span>Building my own products.</p>
      </div>
      <div class="signature">
        <svg class="signature-art" viewBox="0 0 180 180" aria-hidden="true"><g id="grid-dots"></g><g id="live-dots"></g></svg>
        <p class="signature-caption">A few different hats.</p>
        <div class="perspectives" role="tablist" aria-label="Explore Matt’s experience">
          <button id="tab-build" role="tab" aria-selected="true" aria-controls="lens-note" data-lens="build">Build</button>
          <button id="tab-lead" role="tab" aria-selected="false" aria-controls="lens-note" tabindex="-1" data-lens="lead">Lead</button>
          <button id="tab-speak" role="tab" aria-selected="false" aria-controls="lens-note" tabindex="-1" data-lens="speak">Speak</button>
        </div>
        <p class="lens-note" id="lens-note" role="tabpanel" tabindex="0" aria-labelledby="tab-build">From HTML5 games to AI developer tools.</p>
      </div>
    </div>
    <div class="hero-footer">
      <a class="text-link" href="#work">A few things I’ve worked on <span aria-hidden="true">↓</span></a>
      <span class="former">Previously at <img src="/img/logos/atlassian.svg" alt="Atlassian" width="85" height="15" /></span>
    </div>
  </section>

  <section class="home-section" id="work" aria-labelledby="work-title">
    <div class="section-heading"><h2 id="work-title">Selected work</h2><p class="label">AI · Web · Games</p></div>
    <div class="work-list">
      {featuredProjects.map((item) => item.project && (
        <div class="work-row">
          <div class="company">{item.company}<span>{item.area}</span><span>{item.role}</span></div>
          <div class="work-copy">
            <h3><a class="row-link" href={`/projects/${item.id}/`}>{item.displayTitle}</a></h3>
            <p>
              <span data-build={item.build} data-lead={item.lead} data-speak={item.speak}>{item.build}</span>
              {item.extra && <>{' '}<a href={item.extra.href} target="_blank" rel="noopener">{item.extra.label}</a></>}
            </p>
          </div>
          <span class="row-arrow" aria-hidden="true">↗</span>
        </div>
      ))}
    </div>
    <details class="more-work">
      <summary>More from the journey</summary>
      <ul>
        <li><a href="/projects/jira-developer-experiences/">Developer experiences in Jira <span aria-hidden="true">↗</span></a><span>Four new experiences for developers</span></li>
        <li><a href="/projects/playup-draftstars/">PlayUp / Draftstars <span aria-hidden="true">↗</span></a><span>Lead engineer · Zero to one</span></li>
        <li><a href="https://vimeo.com/196944609">The games years <span aria-hidden="true">↗</span></a><span>2016 showreel</span></li>
      </ul>
    </details>
  </section>

  <section class="home-section speaking-home" id="speaking" aria-labelledby="speaking-title">
    <figure>
      <img class="speaking-photo" src="/img/speaking/matt-speaker.jpg" alt="Matt presenting Rovo Dev on stage" width="3024" height="4032" loading="lazy" />
      <figcaption>On stage with Rovo Dev.</figcaption>
    </figure>
    <div>
      <p class="label">On stage</p>
      <h2 id="speaking-title">A few things worth sharing.</h2>
      <p class="section-copy">Talks on AI teams, engineering leadership and the craft of the web. At Web Directions, React Summit and Atlassian events.</p>
      <div class="talk-links">
        {featuredTalks.map((talk) => (
          <a class="talk-link" href={`/speaking/${talk.id}/`}><span>{talk.data.title}</span><span>Watch ↗</span></a>
        ))}
      </div>
      <a class="text-link archive-link" href="/speaking/">All talks & appearances <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="home-section next-chapter" aria-labelledby="next-title">
    <p class="label">The next chapter</p>
    <div>
      <h2 id="next-title">Now, building independently.</h2>
      <p>I’ve moved between engineering and management more than once. Now I’m putting that experience into my own products. If you’re building something and could use that mix, let’s talk.</p>
      <a class="text-link" href="mailto:matt@mattcolman.com">matt@mattcolman.com <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <script>
    const svgNS = 'http://www.w3.org/2000/svg';
    const grid = document.querySelector('#grid-dots');
    const live = document.querySelector('#live-dots');

    if (grid && live) {
      for (let y = 18; y <= 162; y += 18) {
        for (let x = 18; x <= 162; x += 18) {
          const dot = document.createElementNS(svgNS, 'circle');
          dot.setAttribute('cx', String(x));
          dot.setAttribute('cy', String(y));
          dot.setAttribute('r', '.85');
          dot.setAttribute('class', 'grid-dot');
          grid.append(dot);
        }
      }

      const pointsAlong = (d: string, count: number, closed = false) => {
        const path = document.createElementNS(svgNS, 'path');
        path.setAttribute('d', d);
        const length = path.getTotalLength();
        return Array.from({ length: count }, (_, index) => {
          const point = path.getPointAtLength(length * index / (closed ? count : count - 1));
          return [point.x, point.y];
        });
      };
      const ring = (x: number, y: number, radius: number, count: number) => Array.from({ length: count }, (_, index) => [x + Math.cos(index / count * Math.PI * 2) * radius, y + Math.sin(index / count * Math.PI * 2) * radius]);
      const shapes: Record<string, number[][]> = {
        build: [
          ...pointsAlong('M60 54 L24 90 L60 126', 19),
          ...pointsAlong('M105 36 L75 144', 22),
          ...pointsAlong('M120 54 L156 90 L120 126', 19),
        ],
        lead: [
          ...ring(90, 36, 16, 12),
          ...ring(34, 132, 16, 12),
          ...ring(146, 132, 16, 12),
          ...pointsAlong('M90 60 V76', 3),
          ...pointsAlong('M34 84 H146', 15),
          ...pointsAlong('M34 92 V108', 3),
          ...pointsAlong('M146 92 V108', 3),
        ],
        speak: [
          ...pointsAlong('M90 36 A18 18 0 0 1 108 54 V90 A18 18 0 0 1 72 90 V54 A18 18 0 0 1 90 36 Z', 32, true),
          ...pointsAlong('M58 82 V90 A32 32 0 0 0 122 90 V82', 19),
          ...pointsAlong('M90 130 V138', 2),
          ...pointsAlong('M70 146 H110', 7),
        ],
      };
      const notes: Record<string, string> = {
        build: 'From HTML5 games to AI developer tools.',
        lead: 'Teams, product direction and the work of shipping.',
        speak: 'Sharing what I’ve learned along the way.',
      };
      const dots = shapes.build.map(([x, y], index) => {
        const dot = document.createElementNS(svgNS, 'circle');
        dot.setAttribute('r', '2.3');
        dot.setAttribute('class', 'live-dot');
        dot.style.transform = `translate(${x}px, ${y}px)`;
        dot.style.transitionDelay = `${index % 8 * 12}ms`;
        live.append(dot);
        return dot;
      });
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lens]'));
      const note = document.querySelector('#lens-note');

      const setLens = (tab: HTMLButtonElement) => {
        const key = tab.dataset.lens ?? 'build';
        tabs.forEach((item) => {
          item.setAttribute('aria-selected', String(item === tab));
          item.tabIndex = item === tab ? 0 : -1;
        });
        shapes[key].forEach(([x, y], index) => { dots[index].style.transform = `translate(${x}px, ${y}px)`; });
        if (note) {
          note.textContent = notes[key];
          note.setAttribute('aria-labelledby', tab.id);
        }
        document.querySelectorAll<HTMLElement>('[data-build]').forEach((item) => {
          item.textContent = item.dataset[key] ?? item.dataset.build ?? '';
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => setLens(tab));
        tab.addEventListener('keydown', (event) => {
          let next: number | undefined;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
          if (event.key === 'Home') next = 0;
          if (event.key === 'End') next = tabs.length - 1;
          if (next !== undefined) {
            event.preventDefault();
            tabs[next].focus();
            setLens(tabs[next]);
          }
        });
      });
    }
  </script>
</BaseLayout>
