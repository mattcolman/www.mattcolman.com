---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={`${project.data.title} — Matt Colman`} description={project.data.summary}>
  <article class="detail-page">
    <a class="text-link back-link" href="/#work">← Selected work</a>
    <p class="label">{project.data.period} · {project.data.role}</p>
    <h1>{project.data.title}</h1>
    <p class="detail-deck">{project.data.summary}</p>
    <p class="impact">{project.data.impact}</p>
    {project.data.image && <img class="detail-image" src={project.data.image} alt="" />}
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
